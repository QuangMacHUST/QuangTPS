## Widget Development Patterns

### 1. DVH Widget Pattern
Trong DVH widgets, sử dụng pattern này:

```python
class DVHWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setup_ui()
        self.setup_connections()

    def setup_ui(self):
        """Thiết lập giao diện"""
        layout = QVBoxLayout()

        # Canvas cho DVH chart
        self.canvas = DVHCanvas()
        layout.addWidget(self.canvas)

        # Control panel
        self.control_panel = self.create_control_panel()
        layout.addWidget(self.control_panel)

        self.setLayout(layout)

    def setup_connections(self):
        """Kết nối signals và slots"""
        self.structure_combo.currentTextChanged.connect(
            self.on_structure_changed
        )
```

### 2. Error Handling trong UI
```python
from quangtps.core.exceptions import UIError, WidgetError

class SafeWidget(QWidget):
    def update_display(self):
        try:
            # Update operations
            self.refresh_data()

        except WidgetError as e:
            logger.error(f"Widget update failed: {e}")
            self.show_error_message(str(e))

        except Exception as e:
            logger.error(f"Unexpected error: {e}")
            self.show_error_message("Đã xảy ra lỗi không xác định")

    def show_error_message(self, message):
        """Hiển thị thông báo lỗi theo style Eclipse"""
        msg = QMessageBox()
        msg.setIcon(QMessageBox.Warning)
        msg.setWindowTitle("QuangTPS")
        msg.setText(message)
        msg.exec_()
```

### 3. Progressive Loading Pattern
```python
class DataWidget(QWidget):
    def __init__(self):
        super().__init__()
        self.loading_indicator = QProgressBar()
        self.content_widget = QWidget()

    def load_data_async(self):
        """Load dữ liệu không đồng bộ với progress indicator"""
        self.show_loading()

        # Sử dụng QThread cho heavy operations
        self.worker = DataWorker()
        self.worker.finished.connect(self.on_data_loaded)
        self.worker.progress.connect(self.update_progress)
        self.worker.start()

    def show_loading(self):
        self.content_widget.hide()
        self.loading_indicator.show()

    def on_data_loaded(self, data):
        self.loading_indicator.hide()
        self.update_content(data)
        self.content_widget.show()
```

## Icon và Resource Management

### Eclipse-style Icons
```python
def create_eclipse_icon(icon_name, size=16):
    """Tạo icon theo phong cách Eclipse"""

    if icon_name == "plan":
        # Tạo icon kế hoạch xạ trị
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.transparent)

        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.Antialiasing)

        # Vẽ biểu tượng kế hoạch
        painter.setPen(QPen(QColor("#4A90E2"), 2))
        painter.drawEllipse(2, 2, size-4, size-4)

        painter.end()
        return QIcon(pixmap)
```

### Resource Loading với Fallback
```python
def load_ui_resource(resource_path, fallback=None):
    """Load tài nguyên UI với fallback"""
    try:
        return QPixmap(resource_path)
    except Exception as e:
        logger.warning(f"Cannot load resource {resource_path}: {e}")
        if fallback:
            return fallback
        else:
            # Tạo placeholder
            return create_placeholder_pixmap()
```

## Layout Patterns

### Eclipse-style Tab Layout
```python
class MainTabWidget(QTabWidget):
    def __init__(self):
        super().__init__()
        self.setup_tabs()

    def setup_tabs(self):
        # Patient tab
        self.patient_tab = PatientTab()
        self.addTab(self.patient_tab, "Patient")

        # Planning tab
        self.planning_tab = PlanningTab()
        self.addTab(self.planning_tab, "Planning")

        # Evaluation tab
        self.evaluation_tab = EvaluationTab()
        self.addTab(self.evaluation_tab, "Evaluation")

        # Style tabs theo Eclipse
        self.setStyleSheet("""
        QTabWidget::pane {
            border: 1px solid #555555;
            background-color: #2B2B2B;
        }
        QTabBar::tab {
            background-color: #3C3C3C;
            color: #CCCCCC;
            padding: 8px 16px;
        }
        QTabBar::tab:selected {
            background-color: #4A90E2;
        }
        """)
```

### Splitter Layout cho Multi-panel
```python
class PlanningView(QWidget):
    def __init__(self):
        super().__init__()
        self.setup_layout()

    def setup_layout(self):
        # Main horizontal splitter
        main_splitter = QSplitter(Qt.Horizontal)

        # Left panel (object explorer, tools)
        left_panel = self.create_left_panel()
        main_splitter.addWidget(left_panel)

        # Center area (3D view, dose display)
        center_widget = self.create_center_widget()
        main_splitter.addWidget(center_widget)

        # Right panel (DVH, metrics)
        right_panel = self.create_right_panel()
        main_splitter.addWidget(right_panel)

        # Set splitter proportions (20%, 60%, 20%)
        main_splitter.setSizes([200, 600, 200])

        layout = QHBoxLayout()
        layout.addWidget(main_splitter)
        self.setLayout(layout)
```

## Data Binding Patterns

### Model-View Pattern
```python
class StructureListModel(QAbstractListModel):
    def __init__(self, structures):
        super().__init__()
        self.structures = structures

    def data(self, index, role):
        if role == Qt.DisplayRole:
            structure = self.structures[index.row()]
            return structure.name
        elif role == Qt.DecorationRole:
            # Return structure color as icon
            structure = self.structures[index.row()]
            return self.create_color_icon(structure.color)

    def rowCount(self, parent):
        return len(self.structures)
```

### Signal-Slot Connections
```python
class PlanEvaluationTab(QWidget):
    plan_changed = pyqtSignal(object)  # Emit khi plan thay đổi

    def __init__(self):
        super().__init__()
        self.setup_connections()

    def setup_connections(self):
        # Kết nối với các widget con
        self.plan_changed.connect(self.dvh_widget.set_plan)
        self.plan_changed.connect(self.metrics_widget.update_metrics)
        self.plan_changed.connect(self.biological_widget.calculate_tcp_ntcp)
```

