/* 
    QuangTPS - Modern Radiotherapy Treatment Planning System 
    Main Style Sheet
*/

/* Global Application Styles */
QMainWindow, QDialog {
    background-color: #f5f5f7;
    color: #333333;
}

/* Tab Widget Styles */
QTabWidget::pane {
    border: 1px solid #cccccc;
    background-color: white;
    border-radius: 4px;
}

QTabBar::tab {
    background: #e8e8e8;
    border: 1px solid #cccccc;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #555555;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    color: #1a73e8;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #f0f0f0;
}

/* Button Styles */
QPushButton {
    background-color: #1a73e8;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1967d2;
}

QPushButton:pressed {
    background-color: #185abc;
}

QPushButton:disabled {
    background-color: #a7c6fb;
    color: #f0f0f0;
}

/* Secondary Buttons */
QPushButton.secondary {
    background-color: #f8f9fa;
    color: #1a73e8;
    border: 1px solid #dadce0;
}

QPushButton.secondary:hover {
    background-color: #f1f3f4;
    border-color: #d2e3fc;
}

/* Danger Buttons */
QPushButton.danger {
    background-color: #ea4335;
}

QPushButton.danger:hover {
    background-color: #d93025;
}

/* Input Controls */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 8px;
    background-color: white;
    selection-background-color: #d2e3fc;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, 
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #1a73e8;
}

QComboBox::drop-down {
    border: 0px;
}

QComboBox::down-arrow {
    image: url(icons/dropdown_arrow.png);
    width: 12px;
    height: 12px;
}

/* Slider Controls */
QSlider::groove:horizontal {
    border: 1px solid #dadce0;
    height: 8px;
    background: #f8f9fa;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #1a73e8;
    border: 1px solid #1a73e8;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #1967d2;
}

/* Table Styles */
QTableWidget {
    gridline-color: #e0e0e0;
    selection-background-color: #d2e3fc;
    selection-color: #000000;
    border: 1px solid #dadce0;
    border-radius: 4px;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #f8f9fa;
    padding: 6px;
    border: 1px solid #dadce0;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    font-weight: bold;
}

/* Group Box Styles */
QGroupBox {
    border: 1px solid #dadce0;
    border-radius: 4px;
    margin-top: 16px;
    font-weight: bold;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #1a73e8;
}

/* Scroll Bar Styles */
QScrollBar:vertical {
    border: none;
    background: #f5f5f7;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #c1c1c1;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f5f5f7;
    height: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Menu and Status Bar Styles */
QMenuBar {
    background-color: #f8f9fa;
    color: #333333;
    border-bottom: 1px solid #dadce0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background: #e8eaed;
    border-radius: 4px;
}

QMenu {
    background-color: white;
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
}

QMenu::item:selected {
    background-color: #e8eaed;
}

QStatusBar {
    background-color: #f8f9fa;
    color: #5f6368;
    border-top: 1px solid #dadce0;
}

/* Toolbar Styles */
QToolBar {
    background-color: #f8f9fa;
    border-bottom: 1px solid #dadce0;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #dadce0;
    margin: 6px 4px;
}

/* Tool Button Styles */
QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    background-color: transparent;
    padding: 6px;
}

QToolButton:hover {
    background-color: #e8eaed;
    border: 1px solid #dadce0;
}

QToolButton:pressed {
    background-color: #dadce0;
}

/* Specific Widget Styles */
#patientInfoBox {
    background-color: #e8f0fe;
    border-radius: 4px;
    padding: 8px;
}

/* Dose Display Specific Styles */
QWidget#doseColorBar {
    border: 1px solid #dadce0;
    border-radius: 2px;
}

/* DVH Plot Styles - will be applied to Matplotlib plots via parameters */
