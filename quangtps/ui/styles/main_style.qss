/* 
    QuangTPS - Modern Radiotherapy Treatment Planning System 
    Main Style Sheet - Professional Theme
*/

/* Global Application Styles */
QMainWindow, QDialog {
    background-color: #2d3436;
    color: #f5f6fa;
}

/* Tab Widget Styles */
QTabWidget::pane {
    border: 1px solid #404b69;
    background-color: #2d3436;
    border-radius: 2px;
}

QTabBar::tab {
    background: #404b69;
    border: 1px solid #404b69;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #dcdde1;
    min-width: 80px;
    font-weight: normal;
}

QTabBar::tab:selected {
    background: #0984e3;
    border-bottom-color: #0984e3;
    color: white;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #4a69bd;
}

/* Button Styles */
QPushButton {
    background-color: #0984e3;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 3px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #00a8ff;
}

QPushButton:pressed {
    background-color: #0077c8;
}

QPushButton:disabled {
    background-color: #546e7a;
    color: #b2bec3;
}

/* Secondary Buttons */
QPushButton.secondary {
    background-color: #576574;
    color: white;
    border: 1px solid #636e72;
}

QPushButton.secondary:hover {
    background-color: #636e72;
    border-color: #636e72;
}

/* Danger Buttons */
QPushButton.danger {
    background-color: #e84118;
}

QPushButton.danger:hover {
    background-color: #ff5e57;
}

/* Input Controls */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid #546e7a;
    border-radius: 3px;
    padding: 6px;
    background-color: #34495e;
    color: #f5f6fa;
    selection-background-color: #0984e3;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, 
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0984e3;
}

QComboBox::drop-down {
    border: 0px;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(icons/dropdown_arrow.png);
    width: 12px;
    height: 12px;
}

/* Slider Controls */
QSlider::groove:horizontal {
    border: 1px solid #546e7a;
    height: 6px;
    background: #34495e;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #0984e3;
    border: 1px solid #0984e3;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #00a8ff;
}

/* Table Styles */
QTableWidget {
    gridline-color: #546e7a;
    selection-background-color: #0984e3;
    selection-color: #ffffff;
    border: 1px solid #546e7a;
    border-radius: 3px;
    background-color: #2d3436;
    color: #f5f6fa;
    alternate-background-color: #34495e;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #546e7a;
}

QTableWidget::item:selected {
    background-color: #0984e3;
}

QHeaderView::section {
    background-color: #404b69;
    padding: 6px;
    border: 1px solid #546e7a;
    font-weight: bold;
    color: white;
}

/* Group Box Styles */
QGroupBox {
    border: 1px solid #546e7a;
    border-radius: 3px;
    margin-top: 16px;
    font-weight: bold;
    background-color: #34495e;
    color: #f5f6fa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #0984e3;
}

/* Scroll Bar Styles */
QScrollBar:vertical {
    border: none;
    background: #34495e;
    width: 10px;
    margin: 0px 0px 0px 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #576574;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #636e72;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #34495e;
    height: 10px;
    margin: 0px 0px 0px 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #576574;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #636e72;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Menu and Status Bar Styles */
QMenuBar {
    background-color: #2d3436;
    color: #f5f6fa;
    border-bottom: 1px solid #546e7a;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background: #404b69;
    border-radius: 3px;
}

QMenu {
    background-color: #2d3436;
    border: 1px solid #546e7a;
    border-radius: 3px;
    padding: 5px 0px;
    color: #f5f6fa;
}

QMenu::item {
    padding: 8px 32px 8px 20px;
}

QMenu::item:selected {
    background-color: #404b69;
}

QStatusBar {
    background-color: #2d3436;
    color: #dcdde1;
    border-top: 1px solid #546e7a;
}

/* Toolbar Styles */
QToolBar {
    background-color: #2d3436;
    border-bottom: 1px solid #546e7a;
    spacing: 6px;
    padding: 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #546e7a;
    margin: 6px 4px;
}

/* Tool Button Styles */
QToolButton {
    border: 1px solid transparent;
    border-radius: 3px;
    background-color: transparent;
    padding: 5px;
}

QToolButton:hover {
    background-color: #404b69;
    border: 1px solid #546e7a;
}

QToolButton:pressed {
    background-color: #546e7a;
}

QToolButton[popupMode="1"] { /* only for MenuButtonPopup */
    padding-right: 20px; /* make way for the popup button */
}

QToolButton::menu-button {
    border: none;
    border-left: 1px solid #546e7a;
    width: 16px;
}

/* Tree Widget Styles */
QTreeWidget {
    background-color: #2d3436;
    alternate-background-color: #34495e;
    color: #f5f6fa;
    border: 1px solid #546e7a;
    border-radius: 3px;
}

QTreeWidget::item {
    height: 25px;
    border-bottom: 1px solid #546e7a;
}

QTreeWidget::item:selected {
    background-color: #0984e3;
    color: white;
}

QTreeWidget::item:hover {
    background-color: #404b69;
}

/* Separator style */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    border: none;
    background-color: #546e7a;
}

QFrame[frameShape="4"] { /* HLine */
    max-height: 1px;
    min-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    max-width: 1px;
    min-width: 1px;
}

/* Dose Display Specific Styles */
QWidget#doseColorBar {
    border: 1px solid #546e7a;
    border-radius: 2px;
}

/* Patient Info Section */
#patientInfoBox {
    background-color: #404b69;
    border-radius: 3px;
    padding: 10px;
    color: white;
}

/* Specific styles for tabs */
#planningTab, #doseTab, #evaluationTab {
    background-color: #2d3436;
}

/* Custom styling for active workflow steps */
.activeWorkflowStep {
    color: #0984e3;
    font-weight: bold;
    background-color: #404b69;
    border-radius: 3px;
    padding: 5px;
}

/* Custom styling for inactive workflow steps */
.inactiveWorkflowStep {
    color: #b2bec3;
    font-weight: normal;
}

/* Custom styling for completed workflow steps */
.completedWorkflowStep {
    color: #00b894;
    font-weight: bold;
}

/* Widget borders */
QWidget#centralWidget {
    background-color: #2d3436;
    border: none;
}

/* Styling for patient data widgets */
QLabel#patientNameLabel {
    font-size: 14pt;
    font-weight: bold;
    color: white;
}

QLabel#patientIdLabel {
    font-size: 10pt;
    color: #b2bec3;
}

/* Isodose curve display */
QFrame#isodoseFrame {
    background-color: #34495e;
    border-radius: 3px;
    padding: 5px;
}
